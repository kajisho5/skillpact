{
  "contract_version": "0.8",
  "kind": "tool",
  "skill": {
    "name": "v08x-runtime-valid",
    "version": "1.0.0"
  },
  "permissions": {
    "read": {
      "level": "none"
    },
    "write": {
      "level": "none"
    },
    "network": {
      "level": "none"
    },
    "exec": {
      "level": "scoped",
      "scope": [
        "sh"
      ]
    },
    "spend": {
      "level": "none"
    },
    "send": {
      "level": "none"
    }
  },
  "capabilities": [
    {
      "id": "hello",
      "summary": "print",
      "entry": {
        "cli": [
          "sh",
          "$SKILL_DIR/scripts/run.sh"
        ]
      },
      "effects": [
        "exec"
      ],
      "x": {
        "runtime": {
          "errors": {
            "classes": {
              "OOPS": "engine"
            }
          }
        }
      }
    }
  ],
  "tests": {
    "cases": [
      {
        "id": "t1",
        "capability": "hello",
        "run": [
          "sh",
          "$SKILL_DIR/scripts/run.sh"
        ],
        "expect": {
          "exit_code": 0
        },
        "tags": [
          "progress"
        ]
      }
    ]
  },
  "x": {
    "runtime": {
      "progress": {
        "stream": "stderr",
        "flag": "--progress",
        "steps": [
          "read",
          "write"
        ]
      },
      "errors": {
        "classes": {
          "BAD_INPUT": "input",
          "NO_TOOL": "environment",
          "BUSY": "transient"
        }
      }
    }
  }
}
