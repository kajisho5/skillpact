{
  "$schema": "https://kajisho5.github.io/skillpact/schema/v0.6.json",
  "contract_version": "0.6",
  "kind": "tool",
  "skill": {
    "name": "subtitle-skill",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "source": "https://github.com/kajisho5/subtitle-skill",
    "authors": [
      "SEVENTHWELL"
    ]
  },
  "compat": {
    "agents": {
      "claude-code": {
        "status": "expected"
      },
      "cursor": {
        "status": "expected"
      },
      "codex": {
        "status": "expected"
      }
    },
    "interfaces": [
      "skill-md",
      "cli"
    ]
  },
  "requirements": {
    "runtimes": [
      {
        "name": "python3",
        "version": ">=3.9",
        "check": [
          "python3",
          "--version"
        ]
      }
    ],
    "skills": [
      {
        "name": "ffmpeg-skill",
        "version": ">=0.10.0",
        "env": "FFMPEG_SKILL_DIR",
        "optional": true,
        "when": "render / extract-frame / editing operations"
      }
    ],
    "binaries": [
      {
        "name": "ffmpeg",
        "optional": true,
        "when": "run.render",
        "check": [
          "ffmpeg",
          "-version"
        ]
      }
    ]
  },
  "permissions": {
    "read": {
      "level": "scoped",
      "scope": [
        "$INPUT",
        "$SKILL_DIR/**"
      ],
      "why": "subtitle documents and, for render, the source video"
    },
    "write": {
      "level": "scoped",
      "scope": [
        "$OUTPUT",
        "~/.claude/skills/**",
        "~/.cursor/skills/**",
        "~/.codex/skills/**"
      ],
      "why": "writes the subtitle / rendered file; `install` places SKILL.md in agent skill folders"
    },
    "network": {
      "level": "none"
    },
    "exec": {
      "level": "scoped",
      "scope": [
        "python3",
        "ffmpeg",
        "ffprobe"
      ],
      "why": "render delegates to ffmpeg-skill (python3) which runs ffmpeg; doctor checks versions"
    },
    "spend": {
      "level": "none"
    },
    "send": {
      "level": "none"
    }
  },
  "capabilities": [
    {
      "id": "contract",
      "summary": "Print the machine-readable native contract (JSON).",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "subtitle_skill.cli",
          "contract",
          "--json"
        ]
      },
      "effects": [],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "doctor",
      "summary": "Report dependency / health status (ffmpeg-skill, ffmpeg).",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "subtitle_skill.cli",
          "doctor"
        ]
      },
      "effects": [
        "exec"
      ],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "run.generate",
      "summary": "Validate a typed subtitle document and write an SRT/VTT file (no video I/O).",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "subtitle_skill.cli",
          "run"
        ]
      },
      "effects": [
        "read",
        "write"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    },
    {
      "id": "run.render",
      "summary": "Burn in or mux a subtitle into a video by delegating to ffmpeg-skill `caption`.",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "subtitle_skill.cli",
          "run"
        ]
      },
      "effects": [
        "read",
        "write",
        "exec"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    },
    {
      "id": "install",
      "summary": "Place SKILL.md where Claude Code / Cursor / Codex discover skills.",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "subtitle_skill.cli",
          "install"
        ]
      },
      "effects": [
        "write"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    }
  ],
  "tests": {
    "cases": [
      {
        "id": "contract-json",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from subtitle_skill.cli import main;sys.argv=['x','contract','--json'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0,
          "stdout_json": [
            {
              "path": "$.skill_id",
              "equals": "subtitle-skill"
            }
          ]
        }
      },
      {
        "id": "help",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from subtitle_skill.cli import main;sys.argv=['x','--help'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0
        }
      }
    ]
  },
  "x": {
    "seventhwell": {
      "reviewed": "2026-10-22",
      "source_commit": "a950b38",
      "note": "hand-written from the skill's native contract; replaces the init draft"
    }
  },
