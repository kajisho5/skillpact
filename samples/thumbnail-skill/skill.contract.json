{
  "$schema": "https://kajisho5.github.io/skillpact/schema/v0.8.json",
  "contract_version": "0.8",
  "kind": "tool",
  "skill": {
    "name": "thumbnail-skill",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "source": "https://github.com/kajisho5/thumbnail-skill",
    "authors": [
      "SEVENTHWELL"
    ]
  },
  "compat": {
    "agents": {
      "claude-code": {
        "status": "expected"
      },
      "cursor": {
        "status": "expected"
      },
      "codex": {
        "status": "expected"
      }
    },
    "interfaces": [
      "skill-md",
      "cli"
    ]
  },
  "requirements": {
    "runtimes": [
      {
        "name": "python3",
        "version": ">=3.9",
        "check": [
          "python3",
          "--version"
        ]
      }
    ],
    "skills": [
      {
        "name": "ffmpeg-skill",
        "version": ">=0.10.0",
        "env": "FFMPEG_SKILL_DIR",
        "optional": true,
        "when": "render / extract-frame / editing operations"
      }
    ],
    "packages": [
      {
        "ecosystem": "pypi",
        "name": "Pillow",
        "import": "PIL"
      }
    ]
  },
  "permissions": {
    "read": {
      "level": "scoped",
      "scope": [
        "$INPUT",
        "$SKILL_DIR/**"
      ],
      "why": "thumbnail document, image assets, fonts, and (extract-frame) the source video"
    },
    "write": {
      "level": "scoped",
      "scope": [
        "$OUTPUT"
      ],
      "why": "writes the rendered PNG/JPEG"
    },
    "network": {
      "level": "none"
    },
    "exec": {
      "level": "scoped",
      "scope": [
        "python3",
        "ffmpeg"
      ],
      "why": "extract-frame delegates to ffmpeg-skill, which runs ffmpeg"
    },
    "spend": {
      "level": "none"
    },
    "send": {
      "level": "none"
    }
  },
  "capabilities": [
    {
      "id": "contract",
      "summary": "Print the Skill / Capability / Tool contract (JSON).",
      "entry": {
        "cli": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.exit(main())",
          "contract",
          "--json"
        ]
      },
      "effects": [],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "validate",
      "summary": "Validate a ThumbnailDocument structurally; touches no file system.",
      "entry": {
        "cli": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.exit(main())",
          "validate"
        ]
      },
      "effects": [],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "render",
      "summary": "Render a ThumbnailDocument to a PNG/JPEG artifact (Pillow).",
      "entry": {
        "cli": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.exit(main())",
          "render"
        ]
      },
      "effects": [
        "read",
        "write"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    },
    {
      "id": "extract-frame",
      "summary": "Extract a still frame from a video through ffmpeg-skill.",
      "entry": {
        "cli": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.exit(main())",
          "extract-frame"
        ]
      },
      "effects": [
        "read",
        "write",
        "exec"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    },
    {
      "id": "doctor",
      "summary": "Diagnose fonts, ffmpeg-skill and path policy.",
      "entry": {
        "cli": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.exit(main())",
          "doctor"
        ]
      },
      "effects": [
        "read",
        "exec"
      ],
      "requires": [
        "python3"
      ]
    }
  ],
  "tests": {
    "cases": [
      {
        "id": "contract-json",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.argv=['x','contract','--json'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0,
          "stdout_json": [
            {
              "path": "$.skill_id",
              "equals": "thumbnail-skill"
            }
          ]
        }
      },
      {
        "id": "help",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from thumbnail_skill.cli import main;sys.argv=['x','--help'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0
        }
      }
    ]
  },
  "x": {
    "seventhwell": {
      "reviewed": "2026-10-22",
      "source_commit": "e9fc134",
      "note": "hand-written from the skill's native contract; replaces the init draft"
    }
  },
