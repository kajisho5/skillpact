{
  "$schema": "https://kajisho5.github.io/skillpact/schema/v0.8.json",
  "contract_version": "0.8",
  "kind": "tool",
  "skill": {
    "name": "video-editing-skill",
    "version": "0.2.0",
    "license": "Apache-2.0",
    "source": "https://github.com/kajisho5/video-editing-skill",
    "authors": [
      "SEVENTHWELL"
    ]
  },
  "compat": {
    "agents": {
      "claude-code": {
        "status": "expected"
      },
      "cursor": {
        "status": "expected"
      },
      "codex": {
        "status": "expected"
      }
    },
    "interfaces": [
      "skill-md",
      "cli"
    ]
  },
  "requirements": {
    "runtimes": [
      {
        "name": "python3",
        "version": ">=3.9",
        "check": [
          "python3",
          "--version"
        ]
      }
    ],
    "skills": [
      {
        "name": "ffmpeg-skill",
        "version": ">=0.10.0",
        "env": "FFMPEG_SKILL_DIR",
        "optional": true,
        "when": "render / extract-frame / editing operations"
      }
    ]
  },
  "permissions": {
    "read": {
      "level": "scoped",
      "scope": [
        "$INPUT",
        "$SKILL_DIR/**"
      ],
      "why": "edit request and media inside the --allowed-input roots"
    },
    "write": {
      "level": "scoped",
      "scope": [
        "$WORKDIR/**",
        "$OUTPUT"
      ],
      "why": "writes outputs only inside --workspace"
    },
    "network": {
      "level": "none"
    },
    "exec": {
      "level": "scoped",
      "scope": [
        "python3",
        "ffmpeg",
        "ffprobe"
      ],
      "why": "every media operation is a subprocess call to ffmpeg-skill, which runs ffmpeg"
    },
    "spend": {
      "level": "none"
    },
    "send": {
      "level": "none"
    }
  },
  "capabilities": [
    {
      "id": "contract",
      "summary": "Print the manifest / contract (JSON).",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "video_editing_skill",
          "contract",
          "--json"
        ]
      },
      "effects": [],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "validate",
      "summary": "Validate an EditRequest against the workspace and allowed inputs.",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "video_editing_skill",
          "validate"
        ]
      },
      "effects": [
        "read"
      ],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "plan",
      "summary": "Dry run: compile the edit graph without touching media.",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "video_editing_skill",
          "plan"
        ]
      },
      "effects": [
        "read"
      ],
      "requires": [
        "python3"
      ]
    },
    {
      "id": "run",
      "summary": "Execute the edit through ffmpeg-skill inside the workspace.",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "video_editing_skill",
          "run"
        ]
      },
      "effects": [
        "read",
        "write",
        "exec"
      ],
      "destructive": false,
      "requires": [
        "python3"
      ]
    },
    {
      "id": "doctor",
      "summary": "Report dependency status (ffmpeg-skill).",
      "entry": {
        "cli": [
          "python3",
          "-m",
          "video_editing_skill",
          "doctor"
        ]
      },
      "effects": [
        "exec"
      ],
      "requires": [
        "python3"
      ]
    }
  ],
  "tests": {
    "cases": [
      {
        "id": "contract-json",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from video_editing_skill.cli import main;sys.argv=['x','contract','--json'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0,
          "stdout_json": [
            {
              "path": "$.skill_id",
              "equals": "video-editing"
            }
          ]
        }
      },
      {
        "id": "help",
        "capability": "contract",
        "run": [
          "python3",
          "-c",
          "import sys;from video_editing_skill.cli import main;sys.argv=['x','--help'];sys.exit(main())"
        ],
        "env": {
          "PYTHONPATH": "$SKILL_DIR/src"
        },
        "timeout_s": 30,
        "expect": {
          "exit_code": 0
        }
      }
    ]
  },
  "x": {
    "seventhwell": {
      "reviewed": "2026-10-22",
      "source_commit": "2656d9e",
      "note": "hand-written from the skill's native contract; replaces the init draft"
    }
  },
