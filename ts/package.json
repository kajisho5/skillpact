{
  "name": "skillpact",
  "version": "0.8.0",
  "description": "SkillPact verify-only implementation (validate + integrity + ed25519/JCS). Second, independent implementation of the SkillPact spec.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "skillpact": "dist/cli.js",
    "skillpact-verify": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/schema.json dist/",
    "pretest": "npm run build",
    "test": "node --test dist/test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "!dist/test.*",
    "dist/schema.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kajisho5/skillpact.git",
    "directory": "ts"
  },
  "homepage": "https://kajisho5.github.io/skillpact/",
  "keywords": [
    "agent-skills",
    "skill-md",
    "security",
    "claude-code",
    "codex",
    "cursor"
  ]
}
